# ==============================================================================
# HAZTRACK BACKEND CONFIGURATION
# Production Environment Variables Template
# ==============================================================================

# Server Network Configuration
# On Render, Railway, or Heroku, PORT is assigned dynamically by the host.
# HOST MUST be 0.0.0.0 in cloud containers to accept inbound proxy traffic.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (MongoDB Atlas or Self-Hosted)
# Replace with your connection string from MongoDB Atlas:
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (anywhere).
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/haztrack?retryWrites=true&w=majority

# Fallback to Embedded MongoMemoryServer if remote DB is unreachable (true/false)
ALLOW_EMBEDDED_DB_FALLBACK=true

# Authentication & Security
# Generate a strong 64+ char random string for production:
JWT_SECRET=haztrack-production-ecdsa-jwt-master-key-2026-secure-chain
JWT_EXPIRES_IN=7d

# CORS & Client Integration
# Provide your deployed frontend URL(s) without trailing slash:
CLIENT_URL=https://haztrack.vercel.app
CORS_ORIGIN=https://haztrack.vercel.app,https://haztrack.netlify.app

# Application Behavior
# Set to 'false' in strict production environments to disable mock bypass:
DEMO_MODE=true

# Monolithic Single-Service Deployment
# Set to 'true' if the backend should serve built frontend static files from frontend/dist:
SERVE_FRONTEND=true
