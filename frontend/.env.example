# ==============================================================================
# HAZTRACK FRONTEND CONFIGURATION
# Production Environment Variables Template (Vite)
# ==============================================================================

# Backend API Base URL
# Provide the public URL of your deployed backend service:
# Example: https://haztrack-api.onrender.com or https://api.haztrack.gov.in
# Note: In local development, leave empty to automatically use Vite dev proxy (/api).
VITE_API_URL=https://haztrack-api.onrender.com

# Backend Socket.IO Server URL
# Public URL where the Socket.IO WebSocket server is running:
# Example: https://haztrack-api.onrender.com
# Note: If omitted, the frontend automatically derives the socket origin from VITE_API_URL.
VITE_SOCKET_URL=https://haztrack-api.onrender.com

# SECURITY NOTICE:
# Never put database passwords, JWT secrets, or private API keys in frontend .env files!
# Vite exposes all VITE_ prefixed variables to the public client browser bundle.
